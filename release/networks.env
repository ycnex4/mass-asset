# Pinned release parameters (RELEASE.md, step 0). Committed and reviewed; no secrets here.
#
# Networks are identified by genesis hash: an RPC URL that serves another network is refused, whatever
# its name. Values from `solana genesis-hash --url <rpc>` against the official X1 endpoints below
# (2026-11-16). No second independent endpoint was available for a cross-check; the official endpoints
# are the ones the release deploys through, and the two values differ as expected.
MAINNET_RPC=https://rpc.mainnet.x1.xyz
MAINNET_GENESIS=4SvBP3omtvcCVWdxq1zBY5cDp4wndjsThb6nEMn6iMdN
TESTNET_RPC=https://rpc.testnet.x1.xyz
TESTNET_GENESIS=C7ucgdDEhxLTpXHhWSZxavSVmaNTUJWwT5iTdeaviDho
# Testnet preview program (rehearsal target; preview-deploy.sh deploys only this id).
PREVIEW_PROGRAM_ID=CjbH76UhFC1BWCZEdnGGPK3XmV7n5xjKgzPDQ4FStD6R
# Public repository the release binary is built from (fresh checkout of a published commit).
SOURCE_REPO=https://github.com/ycnex4/mass-asset
# Docker image of the verifiable build, pinned by digest (RELEASE.md, step 0):
#   docker pull solanafoundation/solana-verifiable-build:<version>
#   docker inspect --format '{{index .RepoDigests 0}}' solanafoundation/solana-verifiable-build:<version>
# Chosen 2026-11-17: tag 4.0.0 — inside the image cargo-build-sbf 4.0.0, platform-tools v1.53, rustc 1.89.0,
# solana-cli 4.0.0 (Agave), the same toolchain versions the testnet preview was built with locally.
BUILD_IMAGE=solanafoundation/solana-verifiable-build@sha256:0b4e3716fad9ca4b4aac3e3f977f43aad93a18c22296c0c0f44fc22e644bdd68
